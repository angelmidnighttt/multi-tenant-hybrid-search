# Environment variables for the Node app. Copy to app.env.
# Kept separate from .env (docker compose) so the app never sees the superuser password.
PORT=3000
DATABASE_URL=postgresql://app_user:change-me-app@localhost:5432/hybrid_search
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000

# HS256 secret for verifying JWTs (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
JWT_ISSUER=hybrid-search
JWT_AUDIENCE=hybrid-search-api
