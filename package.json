{
  "name": "multi-tenant-hybrid-search",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=app.env src/main.ts",
    "dev": "node --watch --env-file-if-exists=app.env src/main.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "token": "node --env-file-if-exists=app.env scripts/token.ts",
    "worker": "node --env-file-if-exists=app.env src/worker.ts",
    "up": "docker compose up -d --wait",
    "db:up": "docker compose up -d --wait db",
    "db:reset": "docker compose rm -sfv db && docker volume rm hybrid-search_pgdata && docker compose up -d --wait db",
    "models:pull": "docker compose up -d --wait ollama && docker compose exec ollama ollama pull bge-m3"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2"
  }
}
